{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": {
          "Path": "/api/aggregator/{**catch-all}"
        }
      },
      "orders": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "catalog-products": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "catalog-categories": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "catalog-stores": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/stores/{**catch-all}"
        }
      },
      "reviews": {
        "ClusterId": "reviews",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "reviews-storefronts": {
        "ClusterId": "reviews",
        "Match": {
          "Path": "/api/storefronts/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "aggregator": {
        "Destinations": {
          "d1": {
            "Address": "http://aggregator"
          }
        }
      },
      "orders": {
        "Destinations": {
          "d1": {
            "Address": "http://orders-api"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "d1": {
            "Address": "http://catalog-api"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "reviews": {
        "Destinations": {
          "d1": {
            "Address": "http://reviews-api"
          }
        }
      }
    }
  }
}
